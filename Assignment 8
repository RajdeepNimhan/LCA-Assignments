#include <stdio.h>
#include <string.h>

struct Sensor
{
    int id;
    char type[30];
    float reading;
    float min;
    float max;
};

// Function to accept sensor information
void acceptSensors(struct Sensor *s, int n)
{
    int i;

    for(i = 0; i < n; i++)
    {
        printf("\nEnter details of Sensor %d\n", i + 1);

        printf("Enter Sensor ID: ");
        scanf("%d", &(s+i)->id);

        printf("Enter Sensor Type: ");
        scanf("%29s", (s+i)->type);

        printf("Enter Measured Reading: ");
        scanf("%f", &(s+i)->reading);

        printf("Enter Minimum Value: ");
        scanf("%f", &(s+i)->min);

        printf("Enter Maximum Value: ");
        scanf("%f", &(s+i)->max);
    }
}

// Function to check sensor status
int isAbnormal(struct Sensor *s)
{
    if(s->reading < s->min || s->reading > s->max)
        return 1;
    else
        return 0;
}

// Function to calculate average reading
void calculateAverage(struct Sensor *s, int n, char type[])
{
    int i, count = 0;
    float sum = 0, avg;

    for(i = 0; i < n; i++)
    {
        if(strcmp((s+i)->type, type) == 0)
        {
            sum = sum + (s+i)->reading;
            count++;
        }
    }

    if(count > 0)
    {
        avg = sum / count;
        printf("\nAverage reading of %s sensors = %.2f\n",
               type, avg);
    }
    else
    {
        printf("\nNo sensor found of type %s\n", type);
    }
}

// Function to display abnormal sensors
void displayAbnormal(struct Sensor *s, int n)
{
    int i, found = 0;

    printf("\n--- Abnormal Sensors ---\n");

    for(i = 0; i < n; i++)
    {
        if(isAbnormal(s+i))
        {
            printf("\nSensor ID: %d", (s+i)->id);
            printf("\nSensor Type: %s", (s+i)->type);
            printf("\nReading: %.2f", (s+i)->reading);
            printf("\nMinimum Value: %.2f", (s+i)->min);
            printf("\nMaximum Value: %.2f\n", (s+i)->max);

            found = 1;
        }
    }

    if(found == 0)
    {
        printf("No abnormal sensors found.\n");
    }
}

int main()
{
    struct Sensor s[100];
    int n, i;
    char selectedType[30];

    printf("Enter number of sensors: ");
    scanf("%d", &n);

    if(n <= 0 || n > 100)
    {
        printf("Invalid number of sensors.\n");
        return 0;
    }

    // Accept sensor details
    acceptSensors(s, n);

    // Display sensor classification
    printf("\n--- Sensor Classification ---\n");

    for(i = 0; i < n; i++)
    {
        printf("\nSensor ID: %d", s[i].id);

        if(isAbnormal(&s[i]))
            printf("\nStatus: Abnormal\n");
        else
            printf("\nStatus: Normal\n");
    }

    // Calculate average for selected sensor type
    printf("\nEnter sensor type to calculate average: ");
    scanf("%29s", selectedType);

    calculateAverage(s, n, selectedType);

    // Display abnormal sensors
    displayAbnormal(s, n);

    return 0;
}
